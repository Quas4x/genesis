# frozen_string_literal: true

require 'openssl'
require 'json'

# app/services/provider/<%= model.provider_name %>_service.rb
class Provider
  class <%= model.class_name %> < BaseService
    BASE_URL = ENV.fetch('<%= model.env_base_url_key %>', '<%= model.base_url %>')

    def create_request(operation, request_method = 'create')
      payload = build_payout_payload(operation)
      headers = auth_headers
<%- if model.idempotency_header -%>
      headers['<%= model.idempotency_header %>'] = operation.id
<%- end -%>

      response = client.post("#{BASE_URL}<%= model.create_path %>", json: payload, headers: headers)
      parse_create_response(operation, response)
    rescue Provider::RateLimitError
      failure(:too_many_requests, 'provider.rate_limit')
    rescue Provider::UnauthorizedError
      failure(:unauthorized, 'provider.invalid_credentials')
    end

    def fetch_status(operation)
      path = "#{BASE_URL}<%= model.status_path_template.sub(/\{[^}]+\}/, '#{operation.provider_operation_id}') %>"
      response = client.get(path, headers: auth_headers)
      map_status(response.body&.dig('status') || 'failed')
    end

    def process_callback(payload, signature_header = nil)
      verify_signature!(payload, signature_header)
      case payload['event']
      when 'payout.completed' then approve_operation(payload['payout_id'])
      when 'payout.failed'    then reject_operation(payload['payout_id'], payload.dig('error', 'code'))
      else failure(:unprocessable_entity, 'unknown_event')
      end
    end

    def check_conditions(operation, request_method)
      base_result = super
      return base_result if base_result.failed?
      return failure(:unprocessable_entity, 'amount_too_low') if operation.amount < <%= model.min_amount_rub %>

      success
    end

    private

    def auth_headers
      <%= model.auth_headers_expression %>
    end

    def verify_signature!(payload, signature_header)
      secret = credentials.callback_secret
      return unless secret

      body_to_sign = payload.is_a?(String) ? payload : payload.to_json
      expected_sig = OpenSSL::HMAC.hexdigest('SHA256', secret, body_to_sign)

      unless secure_compare(expected_sig, signature_header)
        raise Provider::SignatureVerificationError, 'Invalid webhook signature'
      end
    end

    def secure_compare(a, b)
      return false if a.nil? || b.nil? || a.bytesize != b.bytesize

      OpenSSL.fixed_length_secure_compare(a, b)
    end

    def build_payout_payload(operation)
      {
        amount: (operation.amount * 100).to_i,
        currency: 'RUB',
        external_id: operation.id,
        recipient: {
          type: 'sbp',
          phone: operation.payout_requisite.dig('sbp', 'phone'),
          bank_code: operation.payout_requisite.dig('sbp', 'bank_code'),
          bank_name: operation.payout_requisite.dig('sbp', 'bank_name')
        }
      }
    end

    STATUS_MAP = {
<% model.status_map.each do |k, v| -%>
      '<%= k %>' => '<%= v %>',
<% end -%>
    }.freeze

    ERROR_MAP = {
<% model.error_map.each do |k, v| -%>
      <%= k %> => '<%= v %>',
<% end -%>
    }.freeze
  end
end